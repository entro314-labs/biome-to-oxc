{
  "name": "biome-to-oxc",
  "version": "3.2.0",
  "description": "Migrate from Biome to Oxc ecosystem (oxlint + oxfmt + oxlint-tsgolint)",
  "keywords": [
    "biome",
    "formatter",
    "linter",
    "migration",
    "oxc",
    "oxfmt",
    "oxlint",
    "oxlint-tsgolint",
    "prettier",
    "typescript"
  ],
  "license": "MIT",
  "author": "Dominikos Pritis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entro314-labs/biome-to-oxc.git"
  },
  "bin": {
    "biome-to-oxc": "dist/bin/biome-to-oxc.mjs"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "exports": {
    "types": "./dist/src/index.d.mts",
    "import": "./dist/src/index.mjs"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:fix-unsafe": "oxlint --import-plugin --node-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously .",
    "check:fix-suggestions": "oxlint --import-plugin --node-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions . && oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "docs:sync": "node scripts/sync-rule-inventories.ts",
    "docs:check": "node scripts/sync-rule-inventories.ts --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm docs:check && pnpm test:run",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "dependencies": {
    "commander": "15.0.0",
    "jsonc-parser": "next",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "tsdown": "rc",
    "typescript": "next",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11.25.0"
  },
  "packageManager": "pnpm@11.25.0"
}
